# Optional. Leave blank until these are actually available.
# External registration page (Devfolio, Google Form, ...). When set, every
# Register button links there and the in-page form is hidden.
NEXT_PUBLIC_REGISTER_URL=

# POST endpoint that accepts the JSON registration payload. Until this is set,
# the form validates but says plainly that nothing was sent.
NEXT_PUBLIC_FORM_ENDPOINT=

# Monitored contact address. Leave blank until the inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
